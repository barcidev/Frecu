<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ventana mientras arranca el proceso: siempre la noche de Portadora,
         con el sistema en modo claro u oscuro, para enlazar con la intro, que
         también va en noche. Se quita cuando Flutter dibuja su primer cuadro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Ventana detrás de la interfaz de Flutter mientras se inicia y debajo
         de ella después: el mismo vacío de noche, sin destello blanco. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/portadora_night</item>
    </style>
</resources>
