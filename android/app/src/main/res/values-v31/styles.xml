<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ dibuja su propia pantalla de inicio: el vacío de noche de
         Portadora con la marca de Frecu en señal. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/portadora_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/portadora_night</item>
    </style>
</resources>
